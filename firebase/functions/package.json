{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "emulators": "firebase emulators:start",
    "seed": "tsx scripts/seed.ts",
    "seed:client": "tsx scripts/seed-client.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "dev": "concurrently --names emulators,seed --prefix-colors blue,green \"npm run emulators\" \"wait-on --timeout 120000 http-get://127.0.0.1:8080 && npm run seed\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "gdal-async": "^3.12.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "wait-on": "^8.0.5"
  },
  "private": true
}
