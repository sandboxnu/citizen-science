rules_version = '2';

// No feature uses Storage yet (mobile/src/lib/firebase.ts initializes it but
// nothing uploads). Deny by default until a real feature needs it — when it
// does, scope rules to that path with auth + ownership checks, the same way
// firestore.rules scopes reports/{reportId} to request.auth.uid.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}