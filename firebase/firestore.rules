rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Hazard zones are written only by the server (Cloud Functions).
    // Any client can read them to display flood alerts on the map.
    match /hazard_zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles are created by each user for themselves on sign-up.
    // Users can only read, create, and update their own profile.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // Reports are created by authenticated users.
    // Users can only read and create their own reports.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}