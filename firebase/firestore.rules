rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Predicted flood boundaries from the client's data. Written only by the
    // server. Any client can read them to display on the map.
    match /hazard_zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    // Active NWS flood alerts, written only by pollNWSAlerts. Any client can
    // read them to display on the map.
    match /nws_alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles are created by each user for themselves on sign-up.
    // Users can only read, create, and update their own profile.
    // Field set is locked with hasOnly() so a client can't write an
    // arbitrary field (e.g. a future `role`/`isAdmin`) onto their own doc.
    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'username', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['firstName', 'username', 'email', 'createdAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 100
        && (!('lastName' in request.resource.data)
            || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 100))
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 50
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'username', 'email', 'createdAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 100
        && (!('lastName' in request.resource.data)
            || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 100))
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 50
        && request.resource.data.email is string && request.resource.data.email.size() <= 320;

      allow delete: if false;
    }

    // Username -> email lookup so signed-out users can sign in by username.
    // Doc ID is the lowercased username. Anyone can get one doc by exact
    // username, but nobody can list them. Existing docs can't be overwritten,
    // which also keeps usernames unique.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if false;
    }

    // Reports are created by authenticated users for themselves and are
    // immutable afterward. Field set + types are validated to match
    // mobile/src/lib/reports.ts's submitDuringDisasterReport() and
    // submitPostDisasterReport() payloads.
    match /reports/{reportId} {
      function isDuringDisasterReport(data) {
        return data.keys().hasOnly(['userId', 'disasterType', 'location', 'locationSource', 'observedAt', 'observedAtSource', 'createdAt', 'photos', 'description'])
          && data.keys().hasAll(['userId', 'disasterType', 'location', 'locationSource', 'observedAt', 'observedAtSource', 'createdAt', 'photos'])
          && data.location is latlng
          && data.locationSource in ['photo', 'current', 'edited']
          && data.observedAt is timestamp
          && data.observedAtSource in ['photo', 'current', 'edited']
          && data.photos is list && data.photos.size() <= 20
          && (!('description' in data)
              || (data.description is string && data.description.size() <= 2000));
      }

      // The observation fields on one entry of a post-disaster report's `concerns` list.
      function isConcern(c) {
        return c.location is latlng
          && c.locationSource in ['photo', 'current', 'edited']
          && c.observedAt is timestamp
          && c.observedAtSource in ['photo', 'current', 'edited'];
      }

      // Concern `i`, if the list is that long. Rules can't loop, so each index up to the 20-concern
      // cap is checked explicitly.
      function isConcernAt(concerns, i) {
        return concerns.size() <= i || isConcern(concerns[i]);
      }

      // Location and observation time live on each concern.
      function isPostDisasterReport(data) {
        return data.keys().hasOnly(['userId', 'disasterType', 'createdAt', 'concerns'])
          && data.keys().hasAll(['userId', 'disasterType', 'createdAt', 'concerns'])
          && data.concerns is list && data.concerns.size() > 0 && data.concerns.size() <= 20
          && isConcernAt(data.concerns, 0) && isConcernAt(data.concerns, 1)
          && isConcernAt(data.concerns, 2) && isConcernAt(data.concerns, 3)
          && isConcernAt(data.concerns, 4) && isConcernAt(data.concerns, 5)
          && isConcernAt(data.concerns, 6) && isConcernAt(data.concerns, 7)
          && isConcernAt(data.concerns, 8) && isConcernAt(data.concerns, 9)
          && isConcernAt(data.concerns, 10) && isConcernAt(data.concerns, 11)
          && isConcernAt(data.concerns, 12) && isConcernAt(data.concerns, 13)
          && isConcernAt(data.concerns, 14) && isConcernAt(data.concerns, 15)
          && isConcernAt(data.concerns, 16) && isConcernAt(data.concerns, 17)
          && isConcernAt(data.concerns, 18) && isConcernAt(data.concerns, 19);
      }

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.disasterType in ['flooding', 'earthquake', 'forest_fire']
        // Submission time, set with serverTimestamp() so it's the server's clock, not the device's.
        && request.resource.data.createdAt == request.time
        && (isDuringDisasterReport(request.resource.data)
            || isPostDisasterReport(request.resource.data));
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}